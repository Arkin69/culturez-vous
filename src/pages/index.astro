---
import Avatar from '../components/Avatar.astro';
import DomainChip from '../components/DomainChip.astro';
import TimePicker from '../components/TimePicker.astro';
import VideoCard from '../components/VideoCard.astro';
import Base from '../layouts/Base.astro';
import { allVideos, getData, NOW, withBase } from '../lib/data';
import { formatCount, LEVELS } from '../lib/format';
import { weeklyPick } from '../lib/stats';

const { creators, domains } = await getData();

// Mur d'avatars : les chaînes les plus suivies de chaque domaine, en alternant les domaines.
const wall = domains
  .flatMap((d) => d.creators.filter((c) => c.avatar && c.domain.id === d.id).slice(0, 2))
  .slice(0, 18);

const featured = weeklyPick(
  creators.filter((c) => c.stats.activity !== 'pause'),
  3,
  NOW,
);
const latest = allVideos(creators).slice(0, 12);
const totals = {
  creators: creators.length,
  domains: domains.length,
  videos: creators.reduce((n, c) => n + (c.channel?.videoCount ?? c.videos.length), 0),
  subscribers: creators.reduce((n, c) => n + (c.channel?.subscribers ?? 0), 0),
};
---

<Base current="accueil">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="eyebrow">Annuaire de la vulgarisation francophone</span>
        <h1>Les meilleurs vulgarisateurs, au&nbsp;même&nbsp;endroit.</h1>
        <p class="lead">
          {totals.creators} chaînes YouTube analysées dans {totals.domains} domaines, de la physique quantique à l'histoire de
          l'art. Pour chacune : ce qui la rend unique, pour qui elle est faite, par quelle vidéo commencer, et la liste de
          toutes ses vidéos.
        </p>
        <form class="hero-search" action={withBase('/videos/')} method="get" role="search">
          <label class="visually-hidden" for="hero-q">Rechercher un sujet parmi toutes les vidéos</label>
          <input id="hero-q" class="input" type="search" name="q" placeholder="Un sujet : trous noirs, Rome antique, IA…" />
          <button class="btn btn-primary" type="submit">Chercher</button>
        </form>
        <p class="hero-ask">Que voulez-vous apprendre aujourd'hui&nbsp;?</p>
        <div class="chips">
          {domains.map((d) => <DomainChip domain={d} large />)}
        </div>
      </div>
      <div class="hero-wall" aria-label="Quelques vulgarisateurs de la sélection">
        {
          wall.map((c, i) => (
            <a href={c.url} class={`wall-item w${i % 6}`} title={c.data.name} style={`--h:${c.domain.data.hue}`}>
              <Avatar creator={c} size={96} eager={i < 8} />
              <span class="visually-hidden">{c.data.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TimePicker creators={creators} />
    </div>
  </section>

  <section class="section" aria-labelledby="selection-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Change chaque lundi</span>
          <h2 id="selection-title">La sélection de la semaine</h2>
          <p>Trois vulgarisateurs à découvrir, et la vidéo par laquelle commencer.</p>
        </div>
      </div>
      <div class="spotlights">
        {
          featured.map((c) => (
            <article class="spotlight card" style={`--h:${c.domain.data.hue}`}>
              <div class="spotlight-head">
                <Avatar creator={c} size={72} />
                <div>
                  <h3>
                    <a href={c.url}>{c.data.name}</a>
                  </h3>
                  <div class="chips">
                    <DomainChip domain={c.domain} />
                    <span class="badge no-dot">{LEVELS[c.data.level].short}</span>
                  </div>
                </div>
              </div>
              <p class="spotlight-tagline">{c.data.tagline}</p>
              <p class="muted spotlight-why">{c.data.strengths[0]}.</p>
              {c.starters[0] && (
                <div class="spotlight-video">
                  <p class="field-label">Pour commencer</p>
                  <VideoCard video={c.starters[0]} />
                </div>
              )}
              <a class="btn btn-small spotlight-cta" href={c.url}>
                Découvrir {c.data.name} →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="domaines" aria-labelledby="domaines-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Explorer</span>
          <h2 id="domaines-title">Neuf domaines, des dizaines de passions</h2>
          <p>Chaque domaine a sa présentation et son tableau comparatif, pour savoir qui regarder selon vos goûts.</p>
        </div>
      </div>
      <div class="grid grid-wide">
        {
          domains.map((d) => (
            <a class="dcard card" href={withBase(`/domaines/${d.id}/`)} style={`--h:${d.data.hue}`}>
              <span class="dcard-emoji" aria-hidden="true">
                {d.data.emoji}
              </span>
              <h3>{d.data.title}</h3>
              <p class="muted">{d.data.tagline}</p>
              <div class="dcard-foot">
                <span class="avatar-stack" aria-hidden="true">
                  {d.creators.slice(0, 5).map((c) => (
                    <Avatar creator={c} size={36} />
                  ))}
                </span>
                <span>{d.creators.length} vulgarisateurs</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Tout frais</span>
          <h2 id="latest-title">Les dernières vidéos</h2>
          <p>Ce que viennent de publier les vulgarisateurs de la sélection.</p>
        </div>
        <a class="btn btn-small" href={withBase('/videos/')}>Toutes les vidéos →</a>
      </div>
      <div class="grid">
        {latest.map((v) => <VideoCard video={v} creator={v.creator.data.name} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="numbers-title">
    <div class="container">
      <h2 id="numbers-title" class="visually-hidden">En chiffres</h2>
      <div class="stats">
        <div class="stat"><span class="stat-value">{totals.creators}</span><span class="stat-label">vulgarisateurs analysés</span></div>
        <div class="stat"><span class="stat-value">{totals.domains}</span><span class="stat-label">domaines du savoir</span></div>
        <div class="stat">
          <span class="stat-value">{formatCount(totals.videos)}</span><span class="stat-label">vidéos publiées sur leurs chaînes</span>
        </div>
        <div class="stat">
          <span class="stat-value">{formatCount(totals.subscribers)}</span><span class="stat-label">abonnements cumulés</span>
        </div>
      </div>
      <div class="cta card">
        <div>
          <h3>Comment choisissons-nous&nbsp;?</h3>
          <p class="muted">
            Rigueur, pédagogie, originalité et régularité : nos critères, notre méthode et d'où viennent les données.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn" href={withBase('/a-propos/')}>Notre méthode</a>
          <a class="btn btn-primary" href={withBase('/vulgarisateurs/')}>Voir les {totals.creators} vulgarisateurs</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(36px, 7vw, 88px) clamp(24px, 4vw, 48px);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 980px) {
    .hero-inner {
      grid-template-columns: 1.25fr 1fr;
    }
  }

  .hero h1 {
    max-width: 14ch;
  }

  .hero-search {
    display: flex;
    gap: 8px;
    margin: 28px 0 24px;
    max-width: 560px;
  }

  .hero-search .input {
    border-radius: 999px;
    padding-inline: 20px;
    min-height: 52px;
    font-size: 1.02rem;
    box-shadow: var(--shadow);
  }

  .hero-search .btn {
    min-height: 52px;
    flex: none;
  }

  .hero-ask {
    font-weight: 650;
    margin-bottom: 12px;
  }

  .hero-wall {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    max-width: 520px;
    justify-self: center;
  }

  .wall-item {
    display: block;
    border-radius: 50%;
    padding: 3px;
    background: var(--dom-bg);
    transition: transform 0.2s ease;
  }

  .wall-item :global(.avatar) {
    width: 100%;
    height: auto;
  }

  .wall-item:hover {
    transform: scale(1.08) rotate(-3deg);
  }

  .w1,
  .w4 {
    translate: 0 18px;
  }

  .w2,
  .w5 {
    translate: 0 -8px;
  }

  @media (max-width: 979px) {
    .hero-wall {
      grid-template-columns: repeat(9, 1fr);
      max-width: none;
      width: 100%;
      gap: 8px;
    }

    .w1,
    .w2,
    .w4,
    .w5 {
      translate: none;
    }
  }

  @media (max-width: 560px) {
    .hero-wall {
      grid-template-columns: repeat(6, 1fr);
    }

    .wall-item:nth-child(n + 13) {
      display: none;
    }

    .hero-search .btn {
      padding-inline: 14px;
    }
  }

  .spotlights {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .spotlight {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border-top: 5px solid var(--dom-strong);
  }

  .spotlight-head {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .spotlight-head h3 {
    margin-bottom: 6px;
    font-size: 1.4rem;
  }

  .spotlight-head h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .spotlight-head h3 a:hover {
    color: var(--accent-ink);
  }

  .spotlight-tagline {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 0;
  }

  .spotlight-why {
    margin: 0;
    font-size: 0.95rem;
  }

  .spotlight-video .field-label {
    margin: 0 0 8px;
  }

  .spotlight-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  .dcard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    color: inherit;
    text-decoration: none;
    background:
      linear-gradient(160deg, var(--dom-bg) 0%, transparent 60%),
      var(--surface);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s;
  }

  .dcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
    border-color: var(--dom-strong);
  }

  .dcard-emoji {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 6px;
  }

  .dcard h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .dcard p {
    margin: 0 0 8px;
    font-size: 0.95rem;
  }

  .dcard-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--dom-ink);
  }

  .cta {
    margin-top: 24px;
    padding: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .cta h3 {
    margin-bottom: 4px;
  }

  .cta p {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
